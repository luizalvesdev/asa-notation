[Unit]
Description=asa-notation work agent (Jira + Claude Code)
After=network-online.target

[Service]
ExecStart=/usr/bin/env node %h/Desktop/projetos/asa-notation/tools/asa-runner/runner.mjs
Restart=on-failure
RestartSec=30
# claude, gh and node usually live in the user's PATH, not systemd's.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
